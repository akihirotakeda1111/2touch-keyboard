<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/symbol_keyboard_grid"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:columnCount="8"
    android:rowCount="3"
    android:useDefaultMargins="false">

    <Button
        android:id="@+id/symbol_key_ideographic_comma"
        style="@style/KeyboardKey"
        android:layout_column="0"
        android:layout_row="0"
        android:text="、" />

    <Button
        android:id="@+id/symbol_key_ideographic_period"
        style="@style/KeyboardKey"
        android:layout_column="1"
        android:layout_row="0"
        android:text="。" />

    <Button
        android:id="@+id/symbol_key_comma"
        style="@style/KeyboardKey"
        android:layout_column="2"
        android:layout_row="0"
        android:text="，" />

    <Button
        android:id="@+id/symbol_key_period"
        style="@style/KeyboardKey"
        android:layout_column="3"
        android:layout_row="0"
        android:text="．" />

    <Button
        android:id="@+id/symbol_key_exclamation"
        style="@style/KeyboardKey"
        android:layout_column="4"
        android:layout_row="0"
        android:text="！" />

    <Button
        android:id="@+id/symbol_key_question"
        style="@style/KeyboardKey"
        android:layout_column="5"
        android:layout_row="0"
        android:text="？" />

    <Button
        android:id="@+id/symbol_key_colon"
        style="@style/KeyboardKey"
        android:layout_column="6"
        android:layout_row="0"
        android:text="：" />

    <Button
        android:id="@+id/symbol_key_semicolon"
        style="@style/KeyboardKey"
        android:layout_column="7"
        android:layout_row="0"
        android:text="；" />

    <Button
        android:id="@+id/symbol_key_left_parenthesis"
        style="@style/KeyboardKey"
        android:layout_column="0"
        android:layout_row="1"
        android:text="（" />

    <Button
        android:id="@+id/symbol_key_right_parenthesis"
        style="@style/KeyboardKey"
        android:layout_column="1"
        android:layout_row="1"
        android:text="）" />

    <Button
        android:id="@+id/symbol_key_left_brace"
        style="@style/KeyboardKey"
        android:layout_column="2"
        android:layout_row="1"
        android:text="｛" />

    <Button
        android:id="@+id/symbol_key_right_brace"
        style="@style/KeyboardKey"
        android:layout_column="3"
        android:layout_row="1"
        android:text="｝" />

    <Button
        android:id="@+id/symbol_key_hyphen"
        style="@style/KeyboardKey"
        android:layout_column="4"
        android:layout_row="1"
        android:text="－" />

    <Button
        android:id="@+id/symbol_key_underscore"
        style="@style/KeyboardKey"
        android:layout_column="5"
        android:layout_row="1"
        android:text="＿" />

    <Button
        android:id="@+id/symbol_key_plus"
        style="@style/KeyboardKey"
        android:layout_column="6"
        android:layout_row="1"
        android:text="＋" />

    <Button
        android:id="@+id/symbol_key_equals"
        style="@style/KeyboardKey"
        android:layout_column="7"
        android:layout_row="1"
        android:text="＝" />

    <Button
        android:id="@+id/symbol_key_at"
        style="@style/KeyboardKey"
        android:layout_column="0"
        android:layout_row="2"
        android:text="＠" />

    <Button
        android:id="@+id/symbol_key_hash"
        style="@style/KeyboardKey"
        android:layout_column="1"
        android:layout_row="2"
        android:text="＃" />

    <Button
        android:id="@+id/symbol_key_ampersand"
        style="@style/KeyboardKey"
        android:layout_column="2"
        android:layout_row="2"
        android:text="＆" />

    <Button
        android:id="@+id/symbol_key_dollar"
        style="@style/KeyboardKey"
        android:layout_column="3"
        android:layout_row="2"
        android:text="＄" />

    <Button
        android:id="@+id/symbol_key_asterisk"
        style="@style/KeyboardKey"
        android:layout_column="4"
        android:layout_row="2"
        android:text="＊" />

    <Button
        android:id="@+id/symbol_key_slash"
        style="@style/KeyboardKey"
        android:layout_column="5"
        android:layout_row="2"
        android:text="／" />

    <Button
        android:id="@+id/symbol_key_middle_dot"
        style="@style/KeyboardKey"
        android:layout_column="6"
        android:layout_row="2"
        android:text="・" />

    <Button
        android:id="@+id/symbol_key_close"
        style="@style/KeyboardFunctionKey"
        android:layout_column="7"
        android:layout_row="2"
        android:text="@string/key_symbol_close" />

</GridLayout>
