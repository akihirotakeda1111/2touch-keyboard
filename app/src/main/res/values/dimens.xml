<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 旧レイアウトと同じ外周余白（keyboard_view 実測 336dp を維持） -->
    <dimen name="keyboard_outer_padding">8dp</dimen>
    <!-- キー間隔 1dp（隣接キー間は 2dp の隙間として keyboard_background が見える） -->
    <dimen name="keyboard_key_margin">1dp</dimen>
    <!-- (320dp − 10dp margin) / 5 行 = 62dp。336dp フットプリント維持 -->
    <dimen name="keyboard_key_height">62dp</dimen>
    <!-- 2 行分（62dp × 2 + 行間 2dp） -->
    <dimen name="keyboard_tall_key_height">126dp</dimen>
    <dimen name="keyboard_key_stroke_width">0.5dp</dimen>
    <!-- 候補バーは常時高さを確保し、空のときは透過する（IME リサイズによるタップ欠落を防ぐ） -->
    <dimen name="conversion_hint_height">20sp</dimen>
    <dimen name="candidate_bar_height">48dp</dimen>
</resources>
