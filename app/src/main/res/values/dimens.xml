<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- キーボード外周余白（縮小分はキー高さへ再配分し、全体サイズを維持） -->
    <dimen name="keyboard_outer_padding">4dp</dimen>
    <!-- キー間隔（layout_margin 1dp × 2 = 2dp の隙間） -->
    <dimen name="keyboard_key_margin">1dp</dimen>
    <!-- 通常キー高さ: 外周 padding 削減分を再配分（旧 56dp → 58dp、全体高さはほぼ維持） -->
    <dimen name="keyboard_key_height">58dp</dimen>
    <!-- 2 行分キー + 行間ギャップ 1 つ（2 × 58dp + 2dp） -->
    <dimen name="keyboard_tall_key_height">118dp</dimen>
</resources>
