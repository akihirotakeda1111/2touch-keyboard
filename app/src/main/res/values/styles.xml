<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeyboardKey">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/keyboard_key_height</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_gravity">fill_horizontal</item>
        <item name="android:layout_margin">@dimen/keyboard_key_margin</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="KeyboardFunctionKey" parent="KeyboardKey">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="KeyboardSpaceKey" parent="KeyboardKey">
        <item name="android:layout_height">@dimen/keyboard_key_height</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="KeyboardTallKey" parent="KeyboardFunctionKey">
        <item name="android:layout_height">@dimen/keyboard_tall_key_height</item>
        <item name="android:layout_gravity">fill</item>
    </style>
</resources>
