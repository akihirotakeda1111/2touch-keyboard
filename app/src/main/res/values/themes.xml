<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TwoTouchKeyboard" parent="android:Theme.Material.Light.NoActionBar" />
    <!-- IME サービス専用テーマ: キー領域以外は透過し、背面コンテンツを見せる -->
    <style name="Theme.TwoTouchKeyboard.Ime" parent="@android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
</resources>
