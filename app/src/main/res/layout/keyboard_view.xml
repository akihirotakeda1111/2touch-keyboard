<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:orientation="vertical"
    android:padding="@dimen/keyboard_outer_padding">

    <!-- 高さは常時確保。空のときは背景を透過し、キーボード背景が見える。 -->
    <LinearLayout
        android:id="@+id/candidate_bar_slot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/candidate_bar_margin_bottom"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/conversion_hint"
            android:layout_width="match_parent"
            android:layout_height="@dimen/conversion_hint_height"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingHorizontal="8dp"
            android:textColor="@color/candidate_text"
            android:textSize="13sp"
            android:visibility="invisible" />

        <HorizontalScrollView
            android:id="@+id/candidate_scroll"
            android:layout_width="match_parent"
            android:layout_height="@dimen/candidate_bar_height"
            android:background="@android:color/transparent"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/candidate_container"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal" />

        </HorizontalScrollView>

    </LinearLayout>

    <ViewFlipper
        android:id="@+id/keyboard_flipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:measureAllChildren="false">

        <GridLayout
            android:id="@+id/keyboard_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:rowCount="5"
            android:useDefaultMargins="false">

            <Button
                android:id="@+id/key_1"
                style="@style/KeyboardKey"
                android:layout_column="0"
                android:layout_row="0"
                android:text="1" />

            <Button
                android:id="@+id/key_2"
                style="@style/KeyboardKey"
                android:layout_column="1"
                android:layout_row="0"
                android:text="2" />

            <Button
                android:id="@+id/key_3"
                style="@style/KeyboardKey"
                android:layout_column="2"
                android:layout_row="0"
                android:text="3" />

            <Button
                android:id="@+id/key_delete"
                style="@style/KeyboardFunctionKey"
                android:layout_column="3"
                android:layout_row="0"
                android:text="@string/key_delete" />

            <Button
                android:id="@+id/key_4"
                style="@style/KeyboardKey"
                android:layout_column="0"
                android:layout_row="1"
                android:text="4" />

            <Button
                android:id="@+id/key_5"
                style="@style/KeyboardKey"
                android:layout_column="1"
                android:layout_row="1"
                android:text="5" />

            <Button
                android:id="@+id/key_6"
                style="@style/KeyboardKey"
                android:layout_column="2"
                android:layout_row="1"
                android:text="6" />

            <Button
                android:id="@+id/key_cursor_left"
                style="@style/KeyboardFunctionKey"
                android:layout_column="3"
                android:layout_row="1"
                android:text="@string/key_cursor_left" />

            <Button
                android:id="@+id/key_7"
                style="@style/KeyboardKey"
                android:layout_column="0"
                android:layout_row="2"
                android:text="7" />

            <Button
                android:id="@+id/key_8"
                style="@style/KeyboardKey"
                android:layout_column="1"
                android:layout_row="2"
                android:text="8" />

            <Button
                android:id="@+id/key_9"
                style="@style/KeyboardKey"
                android:layout_column="2"
                android:layout_row="2"
                android:text="9" />

            <Button
                android:id="@+id/key_cursor_right"
                style="@style/KeyboardFunctionKey"
                android:layout_column="3"
                android:layout_row="2"
                android:text="@string/key_cursor_right" />

            <Button
                android:id="@+id/key_star"
                style="@style/KeyboardTallKey"
                android:layout_column="0"
                android:layout_row="3"
                android:layout_rowSpan="2"
                android:text="*" />

            <Button
                android:id="@+id/key_0"
                style="@style/KeyboardKey"
                android:layout_column="1"
                android:layout_row="3"
                android:text="0" />

            <Button
                android:id="@+id/key_hash"
                style="@style/KeyboardKey"
                android:layout_column="2"
                android:layout_row="3"
                android:text="@string/key_symbols" />

            <Button
                android:id="@+id/key_enter"
                style="@style/KeyboardTallKey"
                android:layout_column="3"
                android:layout_row="3"
                android:layout_rowSpan="2"
                android:text="@string/key_enter" />

            <Button
                android:id="@+id/key_text_modifier"
                style="@style/KeyboardKey"
                android:layout_column="1"
                android:layout_row="4"
                android:text="@string/key_text_modifier_kana" />

            <Button
                android:id="@+id/key_space"
                style="@style/KeyboardSpaceKey"
                android:layout_column="2"
                android:layout_row="4"
                android:text="@string/key_space" />

        </GridLayout>

        <include layout="@layout/keyboard_symbol_view" />

    </ViewFlipper>

</LinearLayout>
