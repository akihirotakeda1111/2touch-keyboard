<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:orientation="vertical"
    android:padding="8dp">

    <GridLayout
        android:id="@+id/keyboard_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/key_1"
            style="@style/KeyboardKey"
            android:layout_column="0"
            android:layout_row="0"
            android:text="1" />

        <Button
            android:id="@+id/key_2"
            style="@style/KeyboardKey"
            android:layout_column="1"
            android:layout_row="0"
            android:text="2" />

        <Button
            android:id="@+id/key_3"
            style="@style/KeyboardKey"
            android:layout_column="2"
            android:layout_row="0"
            android:text="3" />

        <Button
            android:id="@+id/key_4"
            style="@style/KeyboardKey"
            android:layout_column="0"
            android:layout_row="1"
            android:text="4" />

        <Button
            android:id="@+id/key_5"
            style="@style/KeyboardKey"
            android:layout_column="1"
            android:layout_row="1"
            android:text="5" />

        <Button
            android:id="@+id/key_6"
            style="@style/KeyboardKey"
            android:layout_column="2"
            android:layout_row="1"
            android:text="6" />

        <Button
            android:id="@+id/key_7"
            style="@style/KeyboardKey"
            android:layout_column="0"
            android:layout_row="2"
            android:text="7" />

        <Button
            android:id="@+id/key_8"
            style="@style/KeyboardKey"
            android:layout_column="1"
            android:layout_row="2"
            android:text="8" />

        <Button
            android:id="@+id/key_9"
            style="@style/KeyboardKey"
            android:layout_column="2"
            android:layout_row="2"
            android:text="9" />

        <Button
            android:id="@+id/key_star"
            style="@style/KeyboardKey"
            android:layout_column="0"
            android:layout_row="3"
            android:text="*" />

        <Button
            android:id="@+id/key_0"
            style="@style/KeyboardKey"
            android:layout_column="1"
            android:layout_row="3"
            android:text="0" />

        <Button
            android:id="@+id/key_hash"
            style="@style/KeyboardKey"
            android:layout_column="2"
            android:layout_row="3"
            android:text="#" />

    </GridLayout>

</LinearLayout>
